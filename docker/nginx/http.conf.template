# Used before a TLS certificate has been issued (first run) — serves the
# app over plain HTTP and exposes the ACME HTTP-01 challenge path so
# certbot can obtain a certificate. deploy.sh swaps this out for
# https.conf.template once certbot succeeds.

server {
    # IPv4 only — Docker's default bridge network does not provide IPv6 to
    # containers unless explicitly configured, and a "listen [::]" that
    # can't bind would stop Nginx from starting at all.
    listen 80;
    server_name __DOMAIN__;

    client_max_body_size 20M;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /static/ {
        alias /app/staticfiles/;
        access_log off;
        expires 30d;
    }

    location /media/ {
        alias /app/media/;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
