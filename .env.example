# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
SECRET_KEY=change-me-to-a-random-50-character-string
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Set DB_ENGINE=postgresql to use PostgreSQL (recommended for staging/production).
# Leave unset / "sqlite" for local development.
DB_ENGINE=sqlite
DB_NAME=annet_platform
DB_USER=annet_platform
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Alternatively supply a single connection string (overrides DB_* above):
# DATABASE_URL=postgres://user:password@host:5432/annet_platform

# --- Cache (optional) ---
# Set to use Redis as the cache backend (recommended in production — see the
# Docker deployment in DEPLOYMENT.md, which sets this automatically). Leave
# blank to use local in-process memory caching (fine for local development).
REDIS_URL=

# --- Email ---
# Defaults to console backend in DEBUG. Set explicitly for staging/production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ANNET Platform <no-reply@annet.org.za>

# --- Platform branding (tenant-level, ANNET is the initial deployment) ---
PLATFORM_NAME=ANNET Digital Network
NETWORK_SHORT_NAME=ANNET
NETWORK_TAGLINE=Unity. Collaboration. Impact.

# --- Uploads ---
MAX_UPLOAD_SIZE_BYTES=15728640

# --- Misc ---
TIME_ZONE=Africa/Johannesburg
LOG_LEVEL=INFO
